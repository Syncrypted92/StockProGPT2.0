# Alpaca API credentials (paper keys by default)
ALPACA_API_KEY=your_paper_api_key
ALPACA_SECRET_KEY=your_paper_secret_key

# Trading environment
PAPER=true
ALLOW_LIVE=false
TRADING_HALTED=false

# Tiingo news / market data (~$30/mo Power plan)
TIINGO_API_KEY=

# Optional: Finnhub (news may require paid tier; Yahoo is fallback)
# FINNHUB_API_KEY=

# Optional override of config path
# STOCKPRO_CONFIG=config/settings.yaml
